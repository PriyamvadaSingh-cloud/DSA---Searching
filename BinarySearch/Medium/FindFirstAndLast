class FirstAndLast {

    public static void main(String[] args) {
        int arr[] = {1, 2, 3, 4, 5, 5, 6};
        int target = 5;

        System.out.println(Firstpos(arr, target));
        System.out.println(Lastpos(arr, target));
    }

    static int Firstpos(int[] arr, int target) {
        int right = arr.length - 1;
        int left = 0;
        int index = -1;   

        while (left <= right) {
            int mid = left + (right - left) / 2;

            if (target == arr[mid]) {
                index = mid;
                right = mid - 1;
            } else if (target < arr[mid]) {
                right = mid - 1;
            } else {
                left = mid + 1;
            }
        }
        return index;
    }

    static int Lastpos(int[] arr, int target) {
        int right = arr.length - 1;
        int left = 0;
        int index = -1;   

        while (left <= right) {
            int mid = left + (right - left) / 2;

            if (target == arr[mid]) {
                index = mid;   
                left = mid + 1;
            } else if (target > arr[mid]) {
                left = mid + 1;
            } else {
                right = mid - 1;
            }
        }
        return index;
    }
}

