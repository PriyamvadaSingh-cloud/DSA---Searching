class MinAbsoluteDiff{
    public int minAbsoluteSumDiff(int[] nums1, int[] nums2) {
        int n= nums1.length;
        long total = 0;
        long maxGain = 0;
        int mod = 1_000_000_007;

        TreeSet<Integer> set = new  TreeSet<>();
             for(int num: nums1){
                set.add(num);
             }

        for (int i=0; i<n; i++){
            int currentDiff = Math.abs(nums1[i] - nums2[i]);
            total+= currentDiff;

            Integer ceil = set.ceiling(nums2[i]);
            if(ceil!=null){
                int newDiff = Math.abs(ceil - nums2[i]);
                maxGain = Math.max(maxGain, currentDiff - newDiff);
            }

            Integer floor = set.floor(nums2[i]);
            if (floor != null) {
                int newDiff = Math.abs(floor - nums2[i]);
                maxGain = Math.max(maxGain, currentDiff - newDiff);
            }
        }     
            return (int)((total - maxGain) % mod);
    }
}