class Duplicate {
    public static void main(String[] args) {
        int arr[] ={};
        sor(arr);
        System.out.println();
    }
    
    public static sort(int[] arr) {
        int i=0;
        
        while(i < arr.length) {
            
            if (arr[i] != i + 1) {
              int correct = arr[i] - 1 ;
              if(arr[correct] != arr[i]) {
                swap(arr, i, correct);
            }else{
                return arr[i];
            }
        }else {
            i++;
        }
    }
    }
    
    static void swap(int[] arr, int first, int second ){
    int temp = arr[first];
    arr[first] = arr[second];
    arr[second] = temp;
    
}
}