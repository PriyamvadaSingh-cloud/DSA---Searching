import java.util.*;

class ranktransform {
    public int[] arrayRankTransform(int[] arr) {

        
        int[] temp = arr.clone();

        
        Arrays.sort(temp);

       
        HashMap<Integer, Integer> map = new HashMap<>();

        int rank = 1;

       
        for (int num : temp) {

            if (!map.containsKey(num)) {

                map.put(num, rank);

                rank++;
            }
        }

        
        for (int i = 0; i < arr.length; i++) {

            arr[i] = map.get(arr[i]);
        }

        return arr;
    }
}

//optimal solution using Hashmap
