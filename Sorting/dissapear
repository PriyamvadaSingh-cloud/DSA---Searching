
import java.util.*;
class Dissapear {
    public static void main(String[] args) {
        
        int arr[] = {1, 3, 2, 7, 8, 2, 3, 1};
        Dissapear obj = new Dissapear();
        List<Integer> result = obj.finDissapearnums(arr);
        
        System.out.println(result);
    }
    
    public List<Integer> finDissapearnums(int[] nums) {
        int i=0;
        
        while(i < nums.length) {
            int correct =  nums[i] - 1;
            
            if(nums[correct] != nums[i]) {
                swap(nums, i, correct);
            }else{
                i++;
            }
        }
        
        //find missing number
        List<Integer> ans = new ArrayList<>();
        for(int index = 0; index < nums.length; index++) {
            if(nums[index] != index+1) {
                ans.add(index + 1);
            }
        }
        return ans;
    }
    
    static void swap(int[] arr, int first, int second){
        int temp = arr[first];
        arr[first] = arr[second];
        arr[second] = temp;
    }
}


//This is Cyclic Sort Pattern used when:

//👉 Array contains numbers from 1 to N
//👉 You need to find missing / duplicate numbers