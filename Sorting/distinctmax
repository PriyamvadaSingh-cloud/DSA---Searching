class Solution {
    public int thirdMax(int[] nums) {
        Arrays.sort(nums);
        
        int count = 1;
        int n = nums.length;

        for(int i = n-2; i >= 0; i--) {
            if(nums[i] != nums[i+1]) {
                  count++;
             }
            if(count == 3){
                return nums[i];
             }
        }
        return nums[n - 1];
}
}

