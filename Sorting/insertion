import java.util.*;

public class InsertionSort {
    public static void main(String[] args) {
        
        int arr[] = {5, 3, 8, 2, 4};

        for (int i = 1; i < arr.length; i++) {
            int key = arr[i];     
            int j = i - 1;

            while (j >= 0 && arr[j] > key) {
                arr[j + 1] = arr[j];
                j = j - 1;
            }

            arr[j + 1] = key;
        }

        System.out.println("Sorted Array:");
        for (int i = 0; i < arr.length; i++) {
            System.out.print(arr[i] + " ");
        }
    }
}