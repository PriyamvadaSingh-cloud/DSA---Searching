Optimal Approach

Since constraints are:

0 <= nums[i] <= 100

We can use counting/frequency array.

Optimal Idea
Count frequency of every number
Convert frequency into prefix sum
Prefix sum tells:
how many numbers are smaller
Optimal Code
class Solution {
    public int[] smallerNumbersThanCurrent(int[] nums) {

        int[] freq = new int[101];

        // Count frequency
        for(int num : nums) {
            freq[num]++;
        }

        // Prefix sum
        for(int i = 1; i < 101; i++) {
            freq[i] = freq[i] + freq[i - 1];
        }

        int[] result = new int[nums.length];

        for(int i = 0; i < nums.length; i++) {

            if(nums[i] == 0) {
                result[i] = 0;
            } else {
                result[i] = freq[nums[i] - 1];
            }
        }

        return result;
    }
}




